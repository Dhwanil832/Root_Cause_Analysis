# Generate a unique 32-byte value for each environment. Never commit the real key.
PROVIDER_VAULT_KEY=

# Optional override for local Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Context is discovered per Ollama model via /api/show; no app-wide 32K cap.
# Hosted providers enforce their own native context and output limits.
# No application generation deadline or output-token cap is set.
RCA_PORT=3016
# Simulation remains separate from RCA. Enable only for a deliberate story test.
RCA_STORY_ENABLED=false
# npm run dev generates RCA_WORKER_TOKEN automatically. Set a shared secret only
# when starting the web process and worker separately. Never commit that value.
